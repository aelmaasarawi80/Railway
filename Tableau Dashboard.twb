      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='main+' name='federated.10db1cz1dpzbu5138kjsz1nkppcy' />
          </datasources>
          <datasource-dependencies datasource='federated.10db1cz1dpzbu5138kjsz1nkppcy'>
            <column caption='# of canceleld and Delayed' datatype='integer' name='[# of canceleld (copy)_759982496210771968]' role='measure' type='quantitative'>
